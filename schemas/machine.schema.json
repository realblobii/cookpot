{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cookpot machine (data/<ns>/recipe/<name>.json)",
  "type": "object",
  "required": [
    "type",
    "block",
    "menu",
    "gui"
  ],
  "properties": {
    "type": {
      "const": "cookpot:machine"
    },
    "block": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "menu": {
      "type": "string"
    },
    "data_slots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "mode": {
      "enum": [
        "timed",
        "instant",
        "staged"
      ]
    },
    "heat": {
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "offset": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "block id, #tag, optionally with [prop=value,...]"
              },
              {
                "type": "object",
                "properties": {
                  "block": {
                    "type": "string"
                  },
                  "tag": {
                    "type": "string"
                  },
                  "properties": {
                    "type": "object"
                  },
                  "speed": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    },
    "process": {
      "type": "object",
      "properties": {
        "default_time": {
          "type": "integer",
          "minimum": 0
        },
        "keep_progress_when_cold": {
          "type": "boolean"
        },
        "lit_property": {
          "type": "string"
        },
        "fuel": {
          "type": "object",
          "required": [
            "slot"
          ],
          "properties": {
            "slot": {
              "type": "string"
            },
            "burn_times": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "game_table": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "sounds": {
      "type": "object",
      "properties": {
        "start": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                },
                "volume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 16
                },
                "pitch": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "interval": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "working": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                },
                "volume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 16
                },
                "pitch": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "interval": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "done": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            },
            {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                },
                "volume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 16
                },
                "pitch": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "interval": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        }
      }
    },
    "gui": {
      "type": "object",
      "required": [
        "slots"
      ],
      "properties": {
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "texture": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "id",
              "role"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "input",
                  "fuel",
                  "container",
                  "output"
                ]
              },
              "pos": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "progress": {
          "type": "object",
          "required": [
            "pos"
          ],
          "properties": {
            "pos": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "flame": {
          "type": "object",
          "required": [
            "pos"
          ],
          "properties": {
            "pos": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
