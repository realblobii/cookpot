{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cookpot recipe (data/<ns>/recipe/<name>.json)",
  "type": "object",
  "required": [
    "type",
    "machine",
    "inputs"
  ],
  "properties": {
    "type": {
      "const": "cookpot:recipe"
    },
    "machine": {
      "type": "string",
      "pattern": ":"
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "item id or #tag"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "object",
            "properties": {
              "item": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          }
        ]
      }
    },
    "container": {
      "oneOf": [
        {
          "type": "string",
          "description": "item id or #tag"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "item": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        }
      ]
    },
    "result": {
      "$ref": "#/definitions/result"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/result"
      }
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "charges": {
      "type": "integer",
      "minimum": 0
    },
    "experience": {
      "type": "number",
      "minimum": 0
    }
  },
  "anyOf": [
    {
      "required": [
        "result"
      ]
    },
    {
      "required": [
        "results"
      ]
    }
  ],
  "definitions": {
    "result": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "components": {
              "type": "object"
            }
          }
        }
      ]
    }
  }
}
